{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope-kb.local/schemas/pwa-kb-adapter-output.schema.json",
  "title": "Hope PWA KB Adapter Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_version",
    "adapter_status",
    "source_snapshot_version",
    "source_snapshot_hash",
    "scene_catalog_status",
    "rule_pack_crosswalk_status",
    "pwa_snapshot",
    "sanitized_summary_contract",
    "fail_closed"
  ],
  "properties": {
    "adapter_version": { "type": "string", "const": "pwa-kb-adapter/v0.2" },
    "adapter_status": { "type": "string", "enum": ["prototype", "candidate", "verified", "activated"] },
    "source_snapshot_version": { "type": "string", "minLength": 1 },
    "source_snapshot_hash": { "type": "string", "pattern": "^sha256:[A-Za-z0-9._-]+$" },
    "scene_catalog_status": { "type": "string", "enum": ["partial", "full"] },
    "rule_pack_crosswalk_status": { "type": "string", "enum": ["prototype", "verified", "not_required"] },
    "pwa_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotVersion",
        "sceneTypes",
        "allowedDurations",
        "writingRulePacks",
        "directorRulePacks",
        "validationRulePacks",
        "sceneMappings",
        "durationProfiles"
      ],
      "properties": {
        "snapshotVersion": { "type": "string", "minLength": 1 },
        "sceneTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allowedDurations": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "writingRulePacks": { "$ref": "#/$defs/rule_pack_array" },
        "directorRulePacks": { "$ref": "#/$defs/rule_pack_array" },
        "validationRulePacks": { "$ref": "#/$defs/rule_pack_array" },
        "sceneMappings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/scene_mapping" }
        },
        "durationProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/duration_profile" } }
      }
    },
    "sanitized_summary_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_only", "allowed_fields", "denied_fields"],
      "properties": {
        "summary_only": { "type": "boolean", "const": true },
        "allowed_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "denied_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "fail_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_required", "fallback_target", "reject_when"],
      "properties": {
        "fallback_required": { "type": "boolean", "const": true },
        "fallback_target": { "type": "string", "minLength": 1 },
        "reject_when": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "rule_pack_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule_pack" }
    },
    "rule_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "intent", "influenceAxes", "directives", "negativeConstraints"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "influenceAxes": { "type": "array", "items": { "type": "string" } },
        "directives": { "type": "array", "items": { "type": "string" } },
        "negativeConstraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scene_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writingRulePackIds",
        "directorRulePackIds",
        "validationRulePackIds",
        "sceneProfile",
        "negativeConstraints",
        "influenceAxes"
      ],
      "properties": {
        "writingRulePackIds": { "type": "array", "items": { "type": "string" } },
        "directorRulePackIds": { "type": "array", "items": { "type": "string" } },
        "validationRulePackIds": { "type": "array", "items": { "type": "string" } },
        "sceneProfile": { "type": "string" },
        "negativeConstraints": { "type": "array", "items": { "type": "string" } },
        "influenceAxes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "duration_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "targetShotCount", "beatDensity", "pacingDirective"],
      "properties": {
        "duration": { "type": "integer", "minimum": 1 },
        "targetShotCount": { "type": "integer", "minimum": 1 },
        "beatDensity": { "type": "string", "minLength": 1 },
        "pacingDirective": { "type": "string", "minLength": 1 }
      }
    }
  }
}
