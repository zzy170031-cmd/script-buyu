{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hope-kb.local/schemas/manual-intake-package.schema.json",
  "title": "Hope KB Manual Intake Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "write_policy",
    "demand",
    "search_plan",
    "source_candidates",
    "screening_results",
    "recommendations",
    "confirmation",
    "kb_application"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hope-kb-manual-intake-package/v0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "request_recorded",
        "sources_collected",
        "screened",
        "recommendations_ready",
        "confirmed_package",
        "applied_to_kb",
        "failed"
      ]
    },
    "write_policy": {
      "type": "object"
    },
    "demand": {
      "type": "object"
    },
    "search_plan": {
      "type": "object"
    },
    "source_candidates": {
      "type": "array"
    },
    "screening_results": {
      "type": "array"
    },
    "recommendations": {
      "type": "array"
    },
    "confirmation": {
      "type": "object"
    },
    "kb_application": {
      "type": "object"
    }
  }
}
